# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Service role — local payment finalize only (never use VITE_ prefix, never commit)
# Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Stripe (put BOTH keys here) ─────────────────────────────────────────────
# Publishable key is safe in the frontend (pk_test_… / pk_live_…)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Secret key — NEVER use a VITE_ prefix (server / Edge Functions only)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Optional: webhook signing secret (after you add the Stripe webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Site URL used for Stripe success/cancel redirects
SITE_URL=http://127.0.0.1:5173

# Registration fee (smallest currency unit, e.g. cents)
VITE_REGISTRATION_FEE_AMOUNT=1000
VITE_REGISTRATION_FEE_CURRENCY=usd

# Optional: IP geolocation lookup used to default the language by country
VITE_GEO_LOOKUP_URL=https://ipapi.co/json/
