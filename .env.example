# ── Supabase (Project Settings → API) ───────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Local finalize only — NEVER add to Vercel, NEVER use VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Stripe ──────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# NEVER add STRIPE_SECRET_KEY to Vercel (Supabase Edge Function secret only)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Local redirects. On Vercel, checkout uses the live site Origin automatically.
SITE_URL=http://localhost:5173

VITE_REGISTRATION_FEE_AMOUNT=1000
VITE_REGISTRATION_FEE_CURRENCY=usd
VITE_GEO_LOOKUP_URL=https://ipapi.co/json/

# ── Vercel dashboard env (Production + Preview) ─────────────────────────────
# VITE_SUPABASE_URL
# VITE_SUPABASE_ANON_KEY
# VITE_STRIPE_PUBLISHABLE_KEY
# VITE_REGISTRATION_FEE_AMOUNT
# VITE_REGISTRATION_FEE_CURRENCY
# Do NOT set: STRIPE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, STRIPE_WEBHOOK_SECRET
